name: Build and Demo

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: maven

      - name: Build runnable jar
        run: mvn -B package

      - name: Run headless demo (creates DB, registers a student, runs an adaptive quiz)
        run: java -jar target/adaptive-quiz.jar --demo

      - name: Upload jar
        uses: actions/upload-artifact@v4
        with:
          name: adaptive-quiz-jar
          path: target/adaptive-quiz.jar
